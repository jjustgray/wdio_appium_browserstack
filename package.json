{
  "name": "wdio-appium-bs-calculator",
  "version": "1.0.0",
  "private": true,
  "description": "Mobile Automation on Appium + WebdriverIO + BrowserStack with Allure Report",
  "scripts": {
    "clean": "rimraf allure-results allure-report",
    "pretest": "npm run clean",
    "pretest:bs": "npm run clean",
    "test:local": "wdio run ./wdio.conf.ts",
    "test:bs": "wdio run ./wdio.bs.conf.ts",
    "report:generate": "allure generate allure-results --clean -o allure-report",
    "report:open": "allure open allure-report",
    "report": "npm run report:generate && npm run report:open"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "^22.0.0",
    "@wdio/allure-reporter": "^9.0.0",
    "@wdio/appium-service": "^9.0.0",
    "@wdio/cli": "^9.0.0",
    "@wdio/local-runner": "^9.0.0",
    "@wdio/mocha-framework": "^9.0.0",
    "@wdio/spec-reporter": "^9.0.0",
    "allure-commandline": "^2.32.0",
    "appium": "^2.11.0",
    "appium-uiautomator2-driver": "^3.7.0",
    "dotenv": "^16.4.7",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.0",
    "wdio-browserstack-service": "latest",
    "webdriverio": "^9.0.0"
  }
}