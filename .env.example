# Path to the Android calculator APK used by local Appium runs.
APP_PATH=com.google.android.calculator
ANDROID_DEVICE_NAME=Android Emulator
ANDROID_PLATFORM_VERSION=14.0

# BrowserStack credentials and the uploaded app identifier (for example, bs://...).
BROWSERSTACK_USERNAME=
BROWSERSTACK_ACCESS_KEY=
BS_APP=
BS_DEVICE_NAME=Google Pixel 8
BS_OS_VERSION=14.0
